};

struct Student {
    string id;
    string nickname;
    string lineId;
    Phone myContact;
    Parent myParent;
};

int main()
{
    Student s;
    s.id = "6811130041";
    s.nickname = "Sa";
    s.lineId = "sxnxtthxpxng";
    s.myContact.mobile = "0637587762";
    s.myContact.home = "0805929080";
    s.myParent.name = "Chamrong";
    s.myParent.relationship = "Father";
    s.myParent.contact.mobile = "0805929080";
    s.myParent.contact.home = "0805929080";

