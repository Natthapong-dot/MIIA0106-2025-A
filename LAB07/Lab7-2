#include <iostream>
using namespace std;
int main() {
	int score = 50;
	int* ptr = &score;
	for (int i = 0; i < 5; i++) {
		cout << "score: " << score << endl;          // แสดงค่า score
		cout << "address of score: " << &score << endl; // แสดง address ของ score
		cout << "pointer ptr: " << ptr << endl;      // แสดง pointer ptr
		cout << endl;
		score += 10;
	}

	return 0;
}
